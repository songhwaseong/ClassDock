{
  "name": "pdf-signer-local",
  "private": true,
  "scripts": {
    "build:spellcheck-worker": "node tools/build-korean-spell-worker.mjs",
    "build:manual": "node tools/build-manual-html.mjs",
    "check:manual": "node tools/build-manual-html.mjs --check",
    "build": "npm run build:spellcheck-worker && npm run build:manual && node build-offline.js",
    "lint": "eslint src/js tests tools desktop *.js",
    "check": "npm run lint && node tools/check-source.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "release-check": "node tools/check-release.js",
    "verify": "npm run check && npm test && npm run build && npm run release-check"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "0.25.8",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "dependencies": {
    "hunspell-dict-ko": "0.1.0",
    "hunspell-wasm": "0.3.0"
  }
}
