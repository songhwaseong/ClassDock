{
 "version": 1,
 "items": [
  {
   "type": "text",
   "x": 10,
   "y": 4,
   "text": "수학Ⅱ · 4점 — 삼차함수와 접선이 둘러싼 넓이",
   "fontSize": 24,
   "color": "#111111",
   "textBaseFontSize": 24
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 18,
   "y": 46,
   "formulaSource": "\\text{최고차항의 계수가 1인 삼차함수 }f(x)\\text{가}\n\\text{다음 조건을 만족시킨다.}\n\\text{(가) 곡선 }y=f(x)\\text{ 위의 점 }(1,\\ f(1))\\text{에서의}\n\\qquad\\text{접선 }l\\text{은 곡선과 }x=4\\text{인 점에서 다시 만난다.}\n\\text{(나) }f'(0)=0\n\\text{(다) 방정식 }f(x)=0\\text{의 서로 다른 실근은 2개이다.}\n\\text{(라) }f(1)<0\n\\text{곡선 }y=f(x)\\text{와 직선 }l\\text{로 둘러싸인 부분의 넓이를}\nS\\text{라 할 때, }4S-f(2)\\text{의 값을 구하시오.}",
   "formulaColor": "#111111",
   "scale": 0.58,
   "w": 540
  },
  {
   "type": "rect",
   "x1": 10,
   "y1": 40,
   "x2": 566,
   "y2": 334,
   "color": "#64748b",
   "width": 2
  },
  {
   "type": "text",
   "x": 596,
   "y": 44,
   "text": "① 착안 — 접하면 중근, 다시 만나면 단근",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 1
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 596,
   "y": 80,
   "formulaSource": "f(x)-l(x)\\text{ 는 최고차항 계수 1인 삼차식}\nx=1\\text{ 에서 접함 }\\Rightarrow\\ (x-1)^2\\text{ 을 인수로}\nx=4\\text{ 에서 만남 }\\Rightarrow\\ (x-4)\\text{ 를 인수로}\n∴\\ f(x)-l(x)=(x-1)^2(x-4)",
   "formulaColor": "#111111",
   "scale": 0.6,
   "w": 620,
   "step": 1
  },
  {
   "type": "text",
   "x": 1250,
   "y": 44,
   "text": "② 식 세우기 — 조건 (나)",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 2
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 1250,
   "y": 80,
   "formulaSource": "l(x)=mx+n\\text{ 이라 하면}\nf(x)=(x-1)^2(x-4)+mx+n\nf'(x)=3x^2-12x+9+m\nf'(0)=0\\ \\Rightarrow\\ m=-9\nf(x)=x^3-6x^2+c\\quad(c=n-4)",
   "formulaColor": "#111111",
   "scale": 0.6,
   "w": 630,
   "step": 2
  },
  {
   "type": "text",
   "x": 10,
   "y": 350,
   "text": "③ 조건 (다) — 극값 하나가 0",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 3
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 18,
   "y": 386,
   "formulaSource": "f'(x)=3x^2-12x=3x(x-4)\n\\text{극값: }f(0)=c,\\quad f(4)=c-32\n\\text{실근 2개}\\ \\Leftrightarrow\\ \\text{극값 중 하나가 0}\nc=0\\ \\text{ 또는 }\\ c=32",
   "formulaColor": "#111111",
   "scale": 0.6,
   "w": 540,
   "step": 3
  },
  {
   "type": "group",
   "role": "education-plot",
   "x": 590,
   "y": 350,
   "w": 400,
   "h": 290,
   "plotSpec": {
    "curves": [
     {
      "source": "x^3 - 6x^2",
      "color": "#2563eb"
     }
    ],
    "xMin": -2,
    "xMax": 7,
    "yMin": -40,
    "yMax": 20,
    "width": 400,
    "height": 290,
    "title": "c = 0 :  y = x^3 - 6x^2"
   },
   "step": 3
  },
  {
   "type": "group",
   "role": "education-plot",
   "x": 1020,
   "y": 350,
   "w": 400,
   "h": 290,
   "plotSpec": {
    "curves": [
     {
      "source": "x^3 - 6x^2 + 32",
      "color": "#9333ea"
     }
    ],
    "xMin": -3,
    "xMax": 6,
    "yMin": -20,
    "yMax": 45,
    "width": 400,
    "height": 290,
    "title": "c = 32 :  y = x^3 - 6x^2 + 32"
   },
   "step": 3
  },
  {
   "type": "text",
   "x": 1450,
   "y": 350,
   "text": "④ 조건 (라) — 하나만 남기기",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 4
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 1450,
   "y": 386,
   "formulaSource": "f(1)=c-5<0\\ \\Rightarrow\\ c<5\n∴\\ c=0\\quad(c=32\\text{ 탈락})\nf(x)=x^3-6x^2",
   "formulaColor": "#111111",
   "scale": 0.6,
   "w": 440,
   "step": 4
  },
  {
   "type": "rect",
   "x1": 586,
