   "step": 5
  },
  {
   "type": "text",
   "x": 1050,
   "y": 690,
   "text": "⑥ 넓이 S",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 6
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 1050,
   "y": 726,
   "formulaSource": "S=\\int_1^4\\{(-9x+4)-(x^3-6x^2)\\}\\,dx\n\\ \\ =\\int_1^4(x-1)^2(4-x)\\,dx\n\\ \\ =\\left[(x-1)^3-\\frac{(x-1)^4}{4}\\right]_1^4\n\\ \\ =27-\\frac{81}{4}=\\frac{27}{4}",
   "formulaColor": "#111111",
   "scale": 0.6,
