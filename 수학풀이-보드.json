  {
   "type": "text",
   "x": 10,
   "y": 690,
   "text": "⑤ 접선 l 구하기",
   "fontSize": 21,
   "color": "#1d4ed8",
   "textBaseFontSize": 21,
   "step": 5
  },
  {
   "type": "image",
   "role": "education-formula",
   "x": 18,
   "y": 726,
   "formulaSource": "f(1)=-5,\\quad f'(1)=3-12=-9\nl:\\ y=-9(x-1)-5=-9x+4",
   "formulaColor": "#111111",
   "scale": 0.6,
   "w": 540,
   "step": 5
  },
